{
  // MicroPython on the ESP32-S3 with mpremote, through tools/esp32.py.
  // Cmd+Shift+B (Ctrl+Shift+B on Windows) runs the file you have open.
  // Other tasks: Terminal > Run Task...
  // No port prompt: tools/esp32.py finds the board's "COM" port (WCH CH343) by itself and paces
  // writes so nothing is lost. To force a port, set ESP32_PORT (see README).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP32: Run current file",
      "type": "shell",
      // Runs through tools/esp32.py so Ctrl+C in this terminal also stops the program ON the ESP32.
      "command": "python3 \"${workspaceFolder}/tools/esp32.py\" run \"${file}\"",
      "windows": { "command": "python \"${workspaceFolder}\\tools\\esp32.py\" run \"${file}\"" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // Always works: ends mpremote on the Mac AND sends Ctrl-C to the ESP32 so the program's
      // finally block turns the motors off. Bind a key to it (see README).
      "label": "ESP32: STOP program (motors off)",
      "type": "shell",
      "command": "python3 \"${workspaceFolder}/tools/esp32.py\" stop",
      "windows": { "command": "python \"${workspaceFolder}\\tools\\esp32.py\" stop" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "focus": false }
    },
    {
      "label": "ESP32: Upload current file as main.py (runs at power-up)",
      "type": "shell",
      "command": "python3 \"${workspaceFolder}/tools/esp32.py\" mp cp \"${file}\" :main.py + reset",
      "windows": { "command": "python \"${workspaceFolder}\\tools\\esp32.py\" mp cp \"${file}\" :main.py + reset" },
      "problemMatcher": []
    },
    {
      "label": "ESP32: Remove main.py (stop auto-run)",
      "type": "shell",
      "command": "python3 \"${workspaceFolder}/tools/esp32.py\" mp rm :main.py + reset",
      "windows": { "command": "python \"${workspaceFolder}\\tools\\esp32.py\" mp rm :main.py + reset" },
      "problemMatcher": []
    },
    {
      "label": "ESP32: Open REPL",
      "type": "shell",
      "command": "python3 \"${workspaceFolder}/tools/esp32.py\" mp repl",
      "windows": { "command": "python \"${workspaceFolder}\\tools\\esp32.py\" mp repl" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "ESP32: List files on board",
      "type": "shell",
      "command": "python3 \"${workspaceFolder}/tools/esp32.py\" mp ls",
      "windows": { "command": "python \"${workspaceFolder}\\tools\\esp32.py\" mp ls" },
      "problemMatcher": []
    },
    {
      "label": "ESP32: List devices (find the port)",
      "type": "shell",
      "command": "python3 -m mpremote devs && python3 \"${workspaceFolder}/tools/esp32.py\" port",
      "windows": { "command": "python -m mpremote devs && python \"${workspaceFolder}\\tools\\esp32.py\" port" },
      "problemMatcher": []
    }
  ]
}
